# Copy to .env and fill in local values. Never commit real secrets.

# --- Database ---
# `docker compose up -d` starts a local Postgres matching this connection string. If port 5432 is
# already bound by a native (non-Docker) Postgres install on your machine, connections will
# silently go to that instead of the container — either stop it, remap the container's host port
# in docker-compose.yml, or create a matching `nori` role/database on your native install and
# point this at it instead.
DATABASE_URL=                  # Postgres connection string, e.g. postgres://nori:nori@localhost:5432/nori

# --- Queue ---
QUEUE_DATABASE_URL=            # Defaults to DATABASE_URL if unset; DB-backed durable queue

# --- Auth (Clerk; each Clerk user gets one personal Nori workspace — see plan/PHASE_3_PLAN.md) ---
# Exact names @clerk/nextjs reads by default; get both from your Clerk app's API Keys page.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Model provider ---
ANTHROPIC_API_KEY=             # Claude API key used by the persona agent
ANTHROPIC_MODEL=claude-sonnet-5

# --- Worker / browser execution ---
WORKER_MAX_ACTIONS_PER_SESSION=20
WORKER_MAX_SESSION_SECONDS=180
WORKER_ALLOWED_ORIGINS=        # comma-separated allowlist of origins the worker may navigate to (fixture-only by default)
WORKER_FIXTURE_MODE=false      # set true only while running the owned local Phase 4 fixture
WORKER_AGENT_MODE=false        # fixture seeding only: use Alex + Claude instead of the fixed fixture persona

# --- Cost controls ---
RUN_HARD_COST_CAP_USD=0.50

# --- Artifact storage ---
ARTIFACT_STORAGE_DIR=./artifacts-storage   # local dev only; replace with object storage config before hosted use
ARTIFACT_RETENTION_DAYS=7

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
